# log-server-for-tos 运行时配置（本文件为唯一可调参数入口；优先级高于 config.json）
# 安装时由 postinst 复制到 /usr/local/log-server-for-tos/log-server-for-tos.env（不存在才复制，不覆盖用户改动）

# ── 监听：管理界面（仅回环；由平台 nginx 反代 http://NAS:8181/log-server-for-tos/）──
LOGSERVER_HTTP_ADDR=127.0.0.1
LOGSERVER_HTTP_PORT=15280

# ── 接收：syslog（对局域网/设备开放；标准端口，需 CAP_NET_BIND_SERVICE）──
LOGSERVER_SYSLOG_UDP_PORT=514
LOGSERVER_SYSLOG_TCP_PORT=514
LOGSERVER_SYSLOG_TLS_PORT=6514
LOGSERVER_SYSLOG_TLS_CERT=/Volume1/@apps/log-server-for-tos/data/config/tls/server.crt
LOGSERVER_SYSLOG_TLS_KEY=/Volume1/@apps/log-server-for-tos/data/config/tls/server.key

# ── 接收准入与每来源限速（FR-603/604）────────────────────────────────
# CIDR 或单个 IP，逗号分隔；allow 为空 = 接受所有来源（兼容旧行为）；deny 优先；
# loopback 默认允许（显式 deny 127.0.0.0/8 可关闭）。UI 保存的设置会覆盖这里并热生效。
#LOGSERVER_RECEIVE_ALLOW_CIDRS=192.168.1.0/24
#LOGSERVER_RECEIVE_DENY_CIDRS=
# 每来源每秒上限（0 = 不限；按来源 IP，不含端口）
LOGSERVER_RECEIVE_MAX_EPS_PER_SOURCE=0
LOGSERVER_RECEIVE_MAX_BYTES_PER_SEC=0

# ── 采集：系统日志（journald）────────────────────────────────────────
# ★ 本应用**只读**：没有权限时不会自我授权（不加系统用户组、不改 ACL、不改 rsyslog/journald 配置）。
#   需要平台授权（R1）后自动开始采集；未授权时「接收」页如实标注「待平台支持」并置灰。
#   auto（默认）= 有权限才采集；off = 关闭；on = 强制尝试（无权限仍会如实降级）
LOGSERVER_JOURNALD_ENABLED=auto
# 从哪个时间点开始读（now = 只收新日志；需要回填历史可写 -1h / "2026-10-14 00:00:00"）
#   注：宿主 /var/log 在内存、journald 为 volatile ⇒ 停机窗口内的日志无法回填（R2）
LOGSERVER_JOURNALD_SINCE=now
# 只采集指定 unit（逗号分隔；留空 = 全部） 例：LOGSERVER_JOURNALD_UNITS=ssh.service,nginx.service
#LOGSERVER_JOURNALD_UNITS=
# 追加给 journalctl 的额外参数（高级用法，留空即可） 例：LOGSERVER_JOURNALD_EXTRA_ARGS=--priority=6
#LOGSERVER_JOURNALD_EXTRA_ARGS=

# ── 接收：SNMP Trap（P1；标准 162 被系统进程占用，故默认用 15162）──
LOGSERVER_SNMP_TRAP_PORT=15162

# ── 存储引擎：VictoriaLogs（仅回环）──
VLOGS_HTTP_ADDR=127.0.0.1
VLOGS_HTTP_PORT=19428
# 默认存储位置（首次安装写入）。用户可在「存储」页改选 /Volume* 下任意目录；
# 选择会写入 <LOGSERVER_DATA_DIR>/config/storage.json，重启应用后生效（FR-307 / D-023）。
# 此处仅是默认值/兜底值。
VLOGS_STORAGE_PATH=/Volume1/@apps/log-server-for-tos/data/engine
VLOGS_RETENTION_PERIOD=14d
VLOGS_RETENTION_MAX_DISK_SPACE=20GiB
# 注：VL **没有全局 -streamFields**；jsonline 写入路径亦无对应 flag
#     → _stream 保持为空（单一物理流），天然规避基数爆炸风险（D-020）
#     若将来改用 VL 原生 -syslog.listenAddr.* 接入，可另设 -syslog.streamFields.{tcp,udp,unix}

# ── 数据与队列（★ 必须在数据卷；绝不写 /var/lib 或系统分区）──
LOGSERVER_DATA_DIR=/Volume1/@apps/log-server-for-tos/data
# 转发目标各自的磁盘队列上限（每目标独立）
LOGSERVER_QUEUE_MAX_BYTES=1073741824

# ── 入库磁盘队列（WAL，D-030）──
# 采集/接收先同步落盘到这里，再批量写存储：存储引擎停机/重启时日志留在队列里，
# 恢复后自动补写（不再丢在内存里）。上限默认 1 GiB，并会自动收紧到卷剩余空间的 10%。
LOGSERVER_INGEST_QUEUE_MAX_BYTES=1073741824
# 队列目录（默认 <LOGSERVER_DATA_DIR>/queue/ingest；改了必须仍在数据卷内且可写）
#LOGSERVER_INGEST_QUEUE_DIR=

# ── 资源档位：low | standard | performance ──
LOGSERVER_RESOURCE_MODE=low

# ── 会话鉴权（复用 TOS 用户与会话，D-008；官方文档 §8.10）──
# tos = 要求携带 TOS 会话（生产默认）；off = 关闭鉴权（**仅限本地开发**）
LOGSERVER_AUTH=tos
# 角色映射：TOS 侧暂无"查询当前用户/角色"公开接口 → 默认最小权限（operator：只读/运维）。
# 管理员操作（改配置/存储位置/导出配置）需在「设置」页输入管理员令牌：
#   首次启动生成 <LOGSERVER_DATA_DIR>/config/admin.token（0600），用 NAS 管理员读取后粘贴。
LOGSERVER_AUTH_ADMINS=
# 兼容旧配置：设为 * 表示"所有已登录 TOS 用户按管理员"（不推荐；安装包升级时会自动取消）。
# 注：平台没有"查询当前用户"接口 → 用户名列表（如 alice）目前无法匹配，只有 * 有意义。
# 自动化/测试可用 LOGSERVER_ADMIN_TOKEN 覆盖令牌文件（至少 16 字符；不要写进正式 env）。
#LOGSERVER_ADMIN_TOKEN=

# ── 能力策略（D-017）：本应用不做任何系统级集成，能力未就绪时在 UI 如实标注 ──
# （保留此注释以便审查者一眼看到我们的边界）
