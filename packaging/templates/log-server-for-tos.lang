[en-us]
name         = "log server for TOS"
auth         = "Moechz"
version      = "__VERSION__"
descript     = "A unified log platform for TOS. It acts as a standard syslog server that receives logs from switches, firewalls and other hosts over UDP/TCP 514 (and TLS 6514 once a certificate is configured), collects file-based logs from paths you choose (with rotation and multi-line handling), searches them with full-text and field filters, forwards selected logs to another log server over UDP/TCP/TLS/HTTP with a durable on-disk queue (nothing is lost while the peer is unreachable), and raises alerts from a built-in rule set covering OOM, disk full, read-only filesystems, hardware and RAID faults, kernel panics, service failures, SSH brute force, account changes and container crashes. A bundled VictoriaLogs engine stores and indexes the logs; it is built from upstream source with a public, bit-reproducible recipe. Everything is processed locally and nothing leaves the NAS unless you configure a forwarding target yourself. The web console opens in a new browser tab and has nine sections: Overview, Monitoring, Audit, Search, Receive, Forward, Storage, Rules and About."
release_note = "First TOS release. Implemented in this version: syslog reception (UDP/TCP with RFC3164, RFC5424 and RFC6587 octet-counting framing), file collection with inode+offset state and rename/copytruncate rotation handling plus multi-line merging, durable on-disk forwarding queues with retry (at-least-once), full-text and field search, a built-in alert rule set with suppression and frequency windows, live overview counters, and the bundled VictoriaLogs engine (self-built from upstream source with a bit-reproducible recipe; no bundled runtime, no online installation). Deployment uses standard syslog ports 514 (UDP/TCP) and 6514 (TLS); the service declares exactly one Linux capability, CAP_NET_BIND_SERVICE, and no other. If any port is already taken, change it in /usr/local/log-server-for-tos/log-server-for-tos.env and restart the service."
important    = "Everything runs locally; no data leaves your NAS unless you add a forwarding target. Features that depend on capabilities TOS does not expose yet (system journal access, container logs, host auditd, TOS log-center and hardware health read APIs) are shown as 'waiting for platform support' in the interface instead of being bypassed. This application does not modify the system: it does not install packages, does not change rsyslog/journald settings, does not add its service user to system groups, and does not touch the firewall. 'apt remove' keeps your data; 'apt purge' deletes the application configuration but never your data or the shared folder. Licensed MIT; the bundled VictoriaLogs is Apache-2.0 (see NOTICE)."

[zh-cn]
name         = "log server for TOS"
auth         = "Moechz"
version      = "__VERSION__"
descript     = "面向 TOS 的统一日志平台。作为标准 syslog 服务器接收交换机 / 防火墙 / 其他主机发来的日志（UDP/TCP 514，配置证书后可用 TLS 6514）；采集你指定的文件日志（支持轮转与多行合并）；提供全文与字段检索；把选中的日志通过 UDP/TCP/TLS/HTTP 转发到另一台日志服务器，并带磁盘持久队列（对端不可达期间不丢日志）；内置规则集覆盖 OOM、磁盘写满、文件系统只读、硬件与 RAID 故障、内核崩溃、服务启动失败、SSH 爆破、账户变更、容器崩溃等场景并产生告警。日志由随包内置的 VictoriaLogs 引擎存储与索引，该引擎由上游源码在公开 CI 中以可位级复现的配方自建。全部数据本地处理，除非你自行配置转发目标，否则不会离开这台 NAS。Web 控制台在 TOS 桌面以新标签页打开，包含九个板块：总览、监控、审计、检索、接收、转发、存储、规则、关于。"
release_note = "首个 TOS 版本。本版已实现：syslog 接收（UDP/TCP，支持 RFC3164、RFC5424 与 RFC6587 octet-counting 帧）、文件采集（inode+offset 位点、rename/copytruncate 轮转、多行合并）、磁盘持久化转发队列 + 重试（至少一次）、全文与字段检索、内置告警规则集（含抑制与频率窗口）、实时总览计数器，以及随包内置的 VictoriaLogs 引擎（由上游源码以可位级复现配方自建；不捆绑运行时、安装过程不联网）。使用标准 syslog 端口 514（UDP/TCP）与 6514（TLS）；服务仅声明一个 Linux 能力 CAP_NET_BIND_SERVICE，不申请任何其他能力。若端口已被占用，请在 /usr/local/log-server-for-tos/log-server-for-tos.env 中修改后重启服务。"
important    = "全部数据在本地处理；除非你添加转发目标，否则不会离开这台 NAS。依赖 TOS 尚未提供的能力（系统日志/journald 访问、容器日志、主机审计 auditd、TOS 日志中心与硬件健康只读接口）的功能，界面会如实标注「待平台支持」并置灰，而不是绕过。本应用不修改系统：不安装系统包、不改动 rsyslog/journald 配置、不把服务用户加入系统用户组、不触碰防火墙。apt remove 保留你的数据；apt purge 只删除应用配置，绝不会删除你的数据与共享文件夹。本应用采用 MIT 许可；内置的 VictoriaLogs 为 Apache-2.0（见 NOTICE）。"

[zh-hk]
name         = "log server for TOS"
auth         = "Moechz"
version      = "__VERSION__"
descript     = "面向 TOS 的統一之日誌平台。作為標準 syslog 伺服器接收交換機 / 防火牆 / 其他主機送來的日誌（UDP/TCP 514，設定憑證後可用 TLS 6514）；採集你指定的檔案日誌（支援輪替與多行合併）；提供全文與欄位檢索；把選定的日誌透過 UDP/TCP/TLS/HTTP 轉發到另一台日誌伺服器，並帶磁碟持久佇列（對端不可達期間不丟日誌）；內建規則集涵蓋 OOM、磁碟寫滿、檔案系統唯讀、硬體與 RAID 故障、核心崩潰、服務啟動失敗、SSH 爆破、帳戶變更、容器崩潰等情境並產生告警。日誌由隨套件內建的 VictoriaLogs 引擎儲存與索引，該引擎由上游原始碼在公開 CI 中以可位元級重現的配方自行建置。所有資料在本機處理，除非你自行設定轉發目標，否則不會離開這台 NAS。Web 控制台會於 TOS 桌面以新分頁開啟，包含九個板塊：總覽、監控、審計、檢索、接收、轉發、儲存、規則、關於。"
release_note = "首個 TOS 版本。本版已實作：syslog 接收（UDP/TCP，支援 RFC3164、RFC5424 與 RFC6587 octet-counting 框）、檔案採集（inode+offset 位點、rename/copytruncate 輪替、多行合併）、磁碟持久化轉發佇列 + 重試（至少一次）、全文與欄位檢索、內建告警規則集（含抑制與頻率視窗）、即時總覽計數器，以及隨套件內建的 VictoriaLogs 引擎（由上游原始碼以可位元級重現配方自行建置；不捆綁執行環境、安裝過程不連網）。使用標準 syslog 埠 514（UDP/TCP）與 6514（TLS）；服務僅宣告一個 Linux 能力 CAP_NET_BIND_SERVICE，不申請其他能力。若埠已被佔用，請於 /usr/local/log-server-for-tos/log-server-for-tos.env 修改後重啟服務。"
important    = "所有資料在本機處理；除非你加入轉發目標，否則不會離開這台 NAS。依賴 TOS 尚未提供的能力（系統日誌/journald 存取、容器日誌、主機審計 auditd、TOS 日誌中心與硬體健康唯讀介面）的功能，介面會如實標註「待平台支援」並置灰，而不是繞過。本應用不修改系統：不安裝系統套件、不改動 rsyslog/journald 設定、不把服務使用者加入系統群組、不觸碰防火牆。apt remove 保留你的資料；apt purge 只刪除應用設定，絕不會刪除你的資料與共享資料夾。本應用採用 MIT 授權；內建的 VictoriaLogs 為 Apache-2.0（見 NOTICE）。"

